# Copy this file to .env.local and fill in what you need, then restart the
# dev server (`npm run dev`).

# --- USDA FoodData Central (optional, recommended for food search) ----------
# Free key at https://fdc.nal.usda.gov/api-key-signup.html
# Without a key, food search uses OpenFoodFacts only.
FDC_API_KEY=

# --- Firebase Auth (optional) ------------------------------------------------
# Enables the email/password + "Continue with Google" sign-in page.
# 1. Create a project at https://console.firebase.google.com
# 2. Build → Authentication → Get started → enable "Email/Password" and
#    "Google" sign-in providers.
# 3. Project settings → Your apps → Web app (</>) → copy the SDK config
#    values (apiKey, authDomain, projectId, appId) into the vars below.
# Without these, Caltrack runs on a local device account (data stays in this
# browser, per-account data split is still applied).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
